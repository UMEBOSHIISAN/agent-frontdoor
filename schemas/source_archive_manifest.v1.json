{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-frontdoor/source-archive-manifest.v1.json",
  "title": "Agent Frontdoor Source Archive Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_version",
    "public_revision",
    "archive_root",
    "regular_file_count",
    "members"
  ],
  "properties": {
    "schema_version": {
      "const": "source-archive-manifest.v1"
    },
    "package_version": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ]
    },
    "public_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "archive_root": {
      "enum": [
        "agent-frontdoor-0.1.0",
        "agent-frontdoor-0.2.0"
      ]
    },
    "regular_file_count": {
      "type": "integer",
      "minimum": 1
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/member"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "package_version"
        ],
        "properties": {
          "package_version": {
            "const": "0.1.0"
          }
        }
      },
      "then": {
        "properties": {
          "archive_root": {
            "const": "agent-frontdoor-0.1.0"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "package_version"
        ],
        "properties": {
          "package_version": {
            "const": "0.2.0"
          }
        }
      },
      "then": {
        "properties": {
          "archive_root": {
            "const": "agent-frontdoor-0.2.0"
          }
        }
      }
    }
  ],
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "size", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
